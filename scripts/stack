#!/usr/bin/env bash
# The local dev stack: `scripts/stack up` starts it and waits until every service is healthy;
# `scripts/stack down` stops it and deletes its data.
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f deploy/local/compose.yaml)

wait_for() {
  local name=$1 url=$2
  for _ in $(seq 60); do
    curl -fsS "$url" >/dev/null 2>&1 && return 0
    sleep 1
  done
  echo "stack: $name not ready at $url" >&2
  return 1
}

case ${1:-} in
  up)
    "${compose[@]}" up -d --wait --wait-timeout 180
    # Tempo's image has no shell tools for a container healthcheck, so poll it from here.
    wait_for tempo http://localhost:3200/ready
    echo "stack: up (postgres :5432, kafka :9092, rustfs :9000/:9001, tempo :3200 otlp :4317/:4318, grafana :3000, anvil :8545)"
    ;;
  down)
    "${compose[@]}" down --volumes --remove-orphans
    ;;
  *)
    echo "usage: scripts/stack up|down" >&2
    exit 2
    ;;
esac
