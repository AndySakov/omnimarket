{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/precommit-gate.sh",
            "if": "Bash(git commit*)",
            "timeout": 600,
            "statusMessage": "verify: fmt, clippy, tests, replay"
          }
        ]
      }
    ]
  }
}
