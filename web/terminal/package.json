{
  "name": "@omnimarket/terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/a11y",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "verify:fast": "npm run typecheck && npm run lint && npm run test:unit",
    "verify": "npm run verify:fast && npm run build",
    "verify:pr": "npm run verify && npm run build-storybook && npm run test:e2e && npm run test:visual && npm run test:a11y"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@vitejs/plugin-react": "^4.3.4",
    "decimal.js": "^10.6.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "msw": "^2.15.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^26.6.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.3"
  }
}
